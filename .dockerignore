# Docker ignore for root directory

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
.next
out
dist
build

# Testing
**/tests/
**/*.test.ts
**/*.spec.ts
**/*.test.js
**/*.spec.js
**/playwright.config.ts
**/coverage/
**/jest.config.js
**/jest.config.ts

# Environment files
.env*.local
.env
.env.production
.env.development

# IDE and editor
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Archive directories
**/archive/

# n8n workflows (not needed for web app)
n8n/

# Database files (not needed for web app)
db/

# Documentation (not needed for runtime)
*.md
!README.md

# Git
.git
.gitignore

# Misc
*.pem
*.key
*.cert
docker-compose*.yml
.dockerignore