import { NextRequest, NextResponse } from 'next/server';
import { S3Client, PutObjectCommand } from '@aws-sdk/client-s3';
const s3 = new S3Client({
  endpoint: 'https://e21ca487c714259a0c1d0ff82c8eff6f.r2.cloudflarestorage.com',
  region: 'auto',
  credentials: {
    accessKeyId: process.env.R2_ACCESS_KEY_ID!,
    secretAccessKey: process.env.R2_SECRET_ACCESS_KEY!,
  },
});
export async function POST(request: NextRequest) {
  try {
    // Get metadata from query params or headers
    const userId = request.nextUrl.searchParams.get('userId');
    const filename = request.nextUrl.searchParams.get('filename');
    if (!userId || !filename) {
      return NextResponse.json(
        { error: 'Missing params', details: 'Need userId and filename in query string' },
        { status: 400 }
      );
    }
    // Get raw binary body
    const arrayBuffer = await request.arrayBuffer();
    
    if (arrayBuffer.byteLength === 0) {
      return NextResponse.json(
        { error: 'Empty body', details: 'No binary data received' },
        { status: 400 }
      );
    }
    const buffer = Buffer.from(arrayBuffer);
    await s3.send(new PutObjectCommand({
      Bucket: 'receiptai-images',
      Key: `receipts/${userId}/${filename}`,
      Body: buffer,
      ContentType: request.headers.get('content-type') || 'image/jpeg',
      ACL: 'public-read',
    }));
    const publicUrl = `https://pub-18f1f7c4601c489e84019b50d64917cd.r2.dev/receipts/${userId}/${filename}`;
    
    return NextResponse.json({ 
      success: true,
      url: publicUrl,
      fileKey: `receipts/${userId}/${filename}`,
      size: buffer.length
    });
  } catch (error) {
    console.error('Upload error:', error);
    return NextResponse.json(
      { error: 'Upload failed', details: String(error) },
      { status: 500 }
    );
  }
}