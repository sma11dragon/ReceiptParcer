# 🔐 ReceiptAI Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git!

# ====================
# DATABASE CONFIGURATION
# ====================

# Production Database (NAS PostgreSQL)
DATABASE_URL="postgresql://username:password@host:port/database_name"

# ====================
# CLOUDFLARE R2 CONFIGURATION  
# ====================

# R2 Access Credentials (from Cloudflare Dashboard → R2 → API Tokens)
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-custom-domain.com"  # Optional: Custom domain for R2
R2_BUCKET_NAME="receiptai-images"

# ====================
# AUTHENTICATION & SECURITY
# ====================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your_jwt_secret_key_here_minimum_32_chars"

# Session Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ====================
# EMAIL SERVICE (Resend)
# ====================

RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"

# ====================
# AUTOMATION (n8n)
# ====================

N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/telegram-receipts"

# ====================
# APPLICATION SETTINGS
# ====================

NODE_ENV="development"
# For production: NODE_ENV="production"

# ====================
# API RATE LIMITING
# ====================

# Rate limiting for API endpoints (requests per minute)
API_RATE_LIMIT="60"

# ====================
# TELEGRAM BOT (Optional)
# ====================

TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# ====================
# AI SERVICES (If using)
# ====================

# Google AI Services
GOOGLE_VISION_API_KEY="your_google_vision_api_key_here"
GOOGLE_GEMINI_API_KEY="your_google_gemini_api_key_here"

# Anthropic Claude
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Groq
GROQ_API_KEY="your_groq_api_key_here"

# Together AI
TOGETHER_AI_API_KEY="your_together_ai_api_key_here"

# Alibaba
ALIBABA_API_KEY="your_alibaba_api_key_here"

# DeepSeek
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# ====================
# SECURITY HEADERS
# ====================

# Content Security Policy (CSP) nonce (optional)
CSP_NONCE="your_csp_nonce_here"

# ====================
# MONITORING & ANALYTICS
# ====================

# Sentry DSN (for error tracking)
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"

# ====================
# DEVELOPMENT SETTINGS
# ====================

# Enable debug logging in development
DEBUG="receiptai:*"

# ====================
# DEPLOYMENT
# ====================

# Vercel deployment (auto-generated, don't modify)
VERCEL_OIDC_TOKEN="auto-generated-by-vercel"

# ====================
# INSTRUCTIONS:
# ====================

# 1. Copy this file to .env.local
# 2. Fill in the actual values for your environment
# 3. Add .env.local to .gitignore
# 4. For production, set these values in Vercel dashboard:
#    - Go to Vercel project → Settings → Environment Variables
#    - Add all variables from this file (except VERCEL_OIDC_TOKEN)
# 5. For local development, use .env.local
# 6. NEVER commit .env.local to version control!