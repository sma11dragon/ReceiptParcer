        "jsCode": "const item = $input.first();\nconst chatId = item.json.chat_id;\nconst isPDF = item.json.is_pdf === true;\n\n// Get binary data\nif (!item.binary) {\n    return {\n        json: {\n            ...item.json,\n            error: true,\n            error_message: 'No binary data'\n        }\n    };\n}\n\nconst binaryKeys = Object.keys(item.binary);\n\n// Find the image/file key\nlet fileKey = null;\nconst photoKeys = binaryKeys.filter(k => k.startsWith('photo'));\n\nif (photoKeys.length > 0) {\n    // Get highest quality photo\n    fileKey = photoKeys.sort().reverse()[0];\n} else if (binaryKeys.includes('data')) {\n    fileKey = 'data';\n} else if (binaryKeys.length > 0) {\n    fileKey = binaryKeys[0];\n}\n\nif (!fileKey) {\n    return {\n        json: {\n            ...item.json,\n            error: true,\n            error_message: 'No file data found'\n        }\n    };\n}\n\nconst binaryData = item.binary[fileKey];\n\n// \u2705 SOFTER VALIDATION - Just check if binaryData exists\nif (!binaryData) {\n    return {\n        json: {\n            ...item.json,\n            error: true,\n            error_message: 'Invalid binary data'\n        }\n    };\n}\n\n// Get filename and mime type\nlet originalFilename = binaryData.fileName || `receipt_${Date.now()}`;\nlet originalMimeType = binaryData.mimeType;\n\n// Add extension if missing\nif (!originalFilename.includes('.')) {\n    if (isPDF) {\n        originalFilename += '.pdf';\n    } else if (originalMimeType?.includes('jpeg') || originalMimeType?.includes('jpg')) {\n        originalFilename += '.jpg';\n    } else if (originalMimeType?.includes('png')) {\n        originalFilename += '.png';\n    } else if (originalMimeType?.includes('heic') || originalMimeType?.includes('heif')) {\n        originalFilename += '.heic';\n    } else {\n        originalFilename += '.jpg'; // default\n    }\n}\n\nreturn {\n    json: {\n        ...item.json,\n        file_key: fileKey,\n        original_filename: originalFilename,\n        original_mime_type: originalMimeType,\n        file_type: isPDF ? 'pdf' : 'image',\n        is_image: true\n    },\n    binary: item.binary\n};"
