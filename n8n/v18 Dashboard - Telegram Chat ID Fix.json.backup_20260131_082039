        "jsCode": "// Get bot_token from input or fallback to Execute Workflow Trigger\nconst botToken = $input.first().json.bot_token || $('Execute Workflow Trigger').first().json.bot_token;\n// AI-POWERED FORMATTER WITH MULTI-PROVIDER FAILOVER\n// Reuses same AI providers as Multi-Tier AI Parser\n\nconst sqlResults = $input.all();\nconst classifyData = $('Classify Query Intent').first().json;\n\nconst queryType = classifyData.query_type;\nconst messageText = classifyData.message_text;\nconst chatId = classifyData.chat_id;\nconst sessionId = classifyData.session_id;\nconst filters = classifyData.filters;\nconst dateField = classifyData.date_field || 'expense_date';\nconst needsClarification = classifyData.needs_clarification || false;\nconst clarificationMessage = classifyData.clarification_message || null;\nconst isValidExpenseQuery = classifyData.is_valid_expense_query !== false;\nconst invalidQueryMessage = classifyData.invalid_query_message || null;\n\n// Handle non-expense related queries (gibberish, off-topic, etc.)\nif (!isValidExpenseQuery && invalidQueryMessage) {\n  return [{\n    json: {\n      session_id: sessionId, chat_id: chatId,\n      output: invalidQueryMessage,\n      query_type: 'invalid',\n      is_valid_expense_query: false\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// Handle ambiguous queries that need clarification\nif (needsClarification && clarificationMessage) {\n  return [{\n    json: {\n      session_id: sessionId, chat_id: chatId,\n      output: clarificationMessage,\n      query_type: 'clarification',\n      needs_user_input: true\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// Handle empty results with helpful suggestions\n// Check for empty SQL results\nif (!sqlResults || sqlResults.length === 0 || (sqlResults[0] && sqlResults[0].json && sqlResults[0].json.sql_results && sqlResults[0].json.sql_results.length === 0)) {\n  let emptyMessage = '\u274c **No expenses found** matching your criteria.\\n\\n';\n  emptyMessage += '\ud83d\udca1 **Try rephrasing your request:**\\n\u2022 Try different spelling or location name\\n\u2022 Use more specific filters (vendor, category, date)\\n\u2022 Ask \"show all my expenses\" to see everything\\n';\n  if (filters.vendor) {\n    emptyMessage += `\u2022 Check if the vendor name \"${filters.vendor}\" is spelled correctly\\n`;\n  }\n  if (filters.category) {\n    emptyMessage += `\u2022 Try a different category (e.g., breakfast, lunch, dinner, transport)\\n`;\n  }\n  if (filters.date_from) {\n    emptyMessage += `\u2022 Try a different date range\\n`;\n  }\n  emptyMessage += '\u2022 Try: \"show all my expenses\" to see everything\\n';\n  emptyMessage += '\u2022 Or: \"list expenses this month\" for recent items';\n  return [{\n    json: {\n      session_id: sessionId, chat_id: chatId,\n      output: emptyMessage,\n      query_type: queryType,\n      filters_applied: filters\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// Convert SQL results to clean JSON\nconst cleanResults = sqlResults.map(item => item.json);\n\n// Build context for AI\nlet context = `Query: \"${messageText}\"\\n`;\ncontext += `Query Type: ${queryType}\\n`;\ncontext += `Date Field: ${dateField}\\n`;\nif (filters.date_from) context += `Date Range: ${filters.date_from} to ${filters.date_to || filters.date_from}\\n`;\nif (filters.category) context += `Category Filter: ${filters.category}\\n`;\nif (filters.location) context += `Location Filter: ${filters.location}\\n`;\n\n// AI PROVIDERS (same as Multi-Tier AI Parser)\nconst API_PROVIDERS = [\n  {\n    name: 'Google Gemini 2.0 Flash',\n    enabled: true,\n    config: (prompt) => ({\n      method: 'POST',\n      url: `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key=AIzaSyA2cfjpSVhdVgBVJPNUyTDDzAxtEcASEpk`,\n      headers: { 'Content-Type': 'application/json' },\n      body: {\n        contents: [{ parts: [{ text: prompt }] }],\n        generationConfig: { temperature: 0.1, maxOutputTokens: 2000 }\n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'Groq Llama 3.3 70B',\n    enabled: true,\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.groq.com/openai/v1/chat/completions',\n      headers: { \n        'Authorization': 'Bearer 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',\n        'Content-Type': 'application/json' \n      },\n      body: { \n        model: 'llama-3.3-70b-versatile', \n        messages: [{ role: 'user', content: prompt }], \n        temperature: 0.1, \n        max_tokens: 2000\n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'Together AI Qwen 2.5 72B',\n    enabled: true,\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.together.xyz/v1/chat/completions',\n      headers: { \n        'Authorization': 'Bearer 44ceef4e6dfb9e28b4a917428b8fa60cd2534337df09c21571a414f45646eade', \n        'Content-Type': 'application/json' \n      },\n      body: { \n        model: 'Qwen/Qwen2.5-72B-Instruct-Turbo', \n        messages: [{ role: 'user', content: prompt }], \n        temperature: 0.1, \n        max_tokens: 2000\n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'DeepSeek Chat',\n    enabled: true,\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.deepseek.com/chat/completions',\n      headers: { \n        'Authorization': 'Bearer sk-b95a3b9d3fc04656a5862bf56319bebb', \n        'Content-Type': 'application/json' \n      },\n      body: { \n        model: 'deepseek-chat', \n        messages: [{ role: 'user', content: prompt }], \n        temperature: 0.1, \n        max_tokens: 2000\n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'Anthropic Claude 3.5 Sonnet',\n    enabled: true,\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.anthropic.com/v1/messages',\n      headers: {\n        'x-api-key': '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',\n        'anthropic-version': '2023-06-01',\n        'content-type': 'application/json'\n      },\n      body: JSON.stringify({\n        model: 'claude-3-5-sonnet-20241022',\n        max_tokens: 2000,\n        messages: [{ role: 'user', content: prompt }]\n      }),\n      timeout: 30000\n    })\n  }\n].filter(provider => provider.enabled);\n\n// Shuffle providers for load balancing\nfunction shuffleArray(array) {\n  const shuffled = [...array];\n  for (let i = shuffled.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n  }\n  return shuffled;\n}\n\nconst shuffledProviders = shuffleArray(API_PROVIDERS);\n\n// PREMIUM AI DASHBOARD PROMPT v6.0\n// Focus: Anti-Hallucination, Vendor Filtering, Self-Verification\nconst CURRENT_DATE = new Date().toLocaleDateString('en-SG', {\n    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Singapore'\n});\n// Extract vendor filter if present for strict filtering\nconst vendorFilter = filters.vendor ? filters.vendor.toLowerCase() : null;\nconst AI_PROMPT_CONFIG = {\n    system_instruction: `You are a High-End Financial Assistant. Format expense data into a \"Premium Financial Dashboard\" style for Telegram.\n\nCURRENT DATE: ${CURRENT_DATE}\n${vendorFilter ? `VENDOR FILTER ACTIVE: \"${vendorFilter}\" - ONLY include records where vendor contains this name!` : ''}\n\n\u26a0\ufe0f CRITICAL ANTI-HALLUCINATION RULES (MANDATORY):\n1. You MUST ONLY use data that appears EXACTLY in the SQL RESULTS below\n2. NEVER invent, assume, or add any vendor names not in the data\n3. NEVER add any amounts not present in the SQL RESULTS\n4. If SQL RESULTS is empty or has 0 records, respond: \"No expenses found matching your criteria \ud83d\udd73\ufe0f\"\n5. Count of items in your response MUST EQUAL count of items in SQL RESULTS\n6. ${vendorFilter ? `STRICT VENDOR FILTER: Only include records where vendor field contains \"${vendorFilter}\"` : 'Include all records from SQL RESULTS'}\n\n\ud83d\udccb SELF-VERIFICATION CHECKLIST (Do this before responding):\n\u2713 Every vendor name I mention exists in SQL RESULTS\n\u2713 Every amount I mention exists in SQL RESULTS\n\u2713 Number of transactions listed = Number of records in SQL RESULTS\n\u2713 I have NOT added any extra items\n\u2713 ${vendorFilter ? `All items match the vendor filter \"${vendorFilter}\"` : 'No vendor filter applied'}\n\nIf you cannot verify ALL checkpoints, use simple format:\n\"\ud83d\udccb [X] expenses found:\\n1. [Vendor] - [Amount]\\n...\"`,\n    formatting_guidelines: `\nLAYOUT STRUCTURE:\n1\ufe0f\u20e3 HEADER:\n- Start with: \"\u2728 Financial Overview: [Period]\"\n- Total line: \"\ud83d\udcb0 *SGD [Amount]*\" (sum of amount_sgd from SQL RESULTS only)\n2\ufe0f\u20e3 SUMMARY METRICS:\n- \"\ud83d\udcca Avg: SGD [X] | \ud83d\udcc8 Max: SGD [Y]\" (calculate from SQL RESULTS only)\n3\ufe0f\u20e3 CATEGORY BREAKDOWN:\n- Icons: \ud83c\udf74 Meals, \u2708\ufe0f Transportation, \ud83d\udecd\ufe0f Shopping, \ud83d\uded2 Groceries, \ud83c\udfac Entertainment, \ud83c\udfe5 Medical, \ud83c\udff7\ufe0f Other\n- Format: \"\u2708\ufe0f *Transportation*: SGD [sum] ([count] receipts) \ud83d\udfe6\ud83d\udfe6\u2b1c\u2b1c\u2b1c\"\n4\ufe0f\u20e3 TRANSACTION LIST (from SQL RESULTS only):\n[1]. *[vendor from SQL]*\n\u2514\u2500 [currency] [amount_original] \u00b7 [category] \u00b7 \ud83d\udcc5 [expense_date]\n\ud83d\udcce [View Receipt](receipt_image_url) - use Markdown hyperlink format, NOT the full URL\n5\ufe0f\u20e3 INSIGHT (based on actual data only):\n\"\ud83d\udca1 *Strategic Insight:* [observation from actual spending patterns]\"\n\nRules:\n- Use *bold* for emphasis\n- Max 4000 characters\n- For lists > 10: \"\u2014\u2014 \ud83d\udcc4 *Showing 10 of [Total] transactions* \u2014\u2014\"\n- IMPORTANT: Format receipt links as Markdown hyperlinks: \ud83d\udcce [View Receipt](URL)\n- NEVER show the full URL - always use [View Receipt](URL) format`\n};\n\n// Integration snippet for Simple Formatter:\nconst PROMPT = `${AI_PROMPT_CONFIG.system_instruction}\\n\\n` +\n    `Query: \"${messageText}\"\\n` +\n    `Metadata: Type=${queryType}\\n\\n` +\n    `SQL RESULTS:\\n${JSON.stringify(cleanResults, null, 2)}\\n\\n` +\n    `${AI_PROMPT_CONFIG.formatting_guidelines}\\n\\n` +\n    `Return the formatted dashboard now:`;\n\n// Provider processing function\nasync function tryProvider(provider, prompt) {\n  try {\n    const startTime = Date.now();\n    const config = provider.config(prompt);\n    const response = await this.helpers.httpRequest(config);\n    const elapsed = ((Date.now() - startTime) / 1000).toFixed(2);\n    \n    let content;\n    if (provider.name.includes('Gemini')) {\n      content = response.candidates?.[0]?.content?.parts?.[0]?.text;\n    } else if (provider.name.includes('Anthropic')) {\n      content = response.content?.[0]?.text;\n    } else {\n      content = response.choices?.[0]?.message?.content;\n    }\n    \n    if (!content) throw new Error('Empty response');\n    \n    \n    return {\n      success: true,\n      output: content.trim(),\n      provider: provider.name,\n      elapsed: parseFloat(elapsed)\n    };\n    \n  } catch (error) {\n    return { success: false };\n  }\n}\n\n// Try providers with failover\nlet result;\nfor (const provider of shuffledProviders) {\n  result = await tryProvider.call(this, provider, PROMPT);\n  \n  if (result.success) {\n    break;\n  }\n}\n\n// SAFE FORMATTER FUNCTION v3.1\n// Generates verified output directly from SQL results with Markdown hyperlinks\nfunction generateSafeOutput(results, qType, vFilter) {\n  let output = '';\n  if (qType === 'count') {\n    const count = results[0]?.total_count || 0;\n    output = `\ud83d\udd22 Found **${count}** expense${count !== 1 ? 's' : ''}`;\n  } else if (qType === 'list' || qType === 'details') {\n    const total = results.reduce((sum, r) => sum + parseFloat(r.amount_sgd || 0), 0);\n    output = `\ud83d\udccb **Your Expenses** (${results.length} items)\\n\ud83d\udcb0 Total: **SGD ${total.toFixed(2)}**\\n\\n`;\n    results.forEach((row, idx) => {\n      output += `${idx + 1}. **${row.vendor}**\\n`;\n      output += `   \u2514\u2500 ${row.currency || 'SGD'} ${parseFloat(row.amount_original || row.amount_sgd).toFixed(2)} \u00b7 ${row.category || 'Uncategorized'} \u00b7 \ud83d\udcc5 ${row.expense_date}\\n`;\n      if (row.receipt_image_url) {\n        output += `   \ud83d\udcce [View Receipt](${row.receipt_image_url})\\n`;\n      }\n    });\n  } else {\n    output = `Found ${results.length} results.`;\n  }\n  return output;\n}\n\n// Fallback to simple formatting if all AI providers fail\nif (!result || !result.success) {\n  const output = generateSafeOutput(cleanResults, queryType, vendorFilter);\n  return [{\n    json: {\n      session_id: sessionId, chat_id: chatId,\n      output: output,\n      query_type: queryType,\n      formatted_by: 'fallback',\n      verified: true\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// RESPONSE VERIFICATION v1.0\n// Check AI output for hallucinations before returning\nconst actualVendors = cleanResults.map(r => (r.vendor || '').toLowerCase());\nconst aiOutput = result.output;\nlet hallucinated = false;\nlet hallucinatedItems = [];\n\n// Extract vendor mentions from AI output (look for numbered list patterns)\nconst vendorMentions = aiOutput.match(/\\d+\\.\\s*\\*?\\*?([^\\n*\u2514\u2500\u00b7]+)/g) || [];\nfor (const mention of vendorMentions) {\n  const cleanMention = mention.replace(/^\\d+\\.\\s*\\*?\\*?/, '').trim().toLowerCase().split('*')[0].trim();\n  if (cleanMention.length > 2) {\n    const matchFound = actualVendors.some(v => \n      v && (cleanMention.includes(v) || v.includes(cleanMention.split(' ')[0]))\n    );\n    if (!matchFound && !cleanMention.match(/^(sgd|myr|thb|usd|\\d|total|avg|max|min)/i)) {\n      hallucinated = true;\n      hallucinatedItems.push(cleanMention);\n    }\n  }\n}\n\n// If hallucination detected, use safe formatter instead\nif (hallucinated && hallucinatedItems.length > 0) {\n  const safeOutput = generateSafeOutput(cleanResults, queryType, vendorFilter);\n  return [{\n    json: {\n      session_id: sessionId, chat_id: chatId,\n      output: safeOutput + `\\n\\n\u26a0\ufe0f _Response verified for accuracy_`,\n      query_type: queryType,\n      formatted_by: 'verified_fallback',\n      hallucination_detected: true,\n      flagged_items: hallucinatedItems,\n      verified: true\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// Return AI-formatted result (passed verification)\nreturn [{\n  json: {\n    session_id: sessionId, chat_id: chatId,\n    output: result.output,\n    query_type: queryType,\n    formatted_by: result.provider,\n    formatting_time: result.elapsed,\n    verified: true\n  ,\n    bot_token: botToken}\n}];"
