      "parameters": {
        "jsCode": "// Telegram message splitter - handles 4096 character limit\nconst TELEGRAM_MAX_LENGTH = 4000; // Safe margin below 4096\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const chatId = item.json.chat_id;\n  const output = item.json.output || item.json.text || '';\n  \n  \n  // If message fits in one telegram message, send as-is\n  if (output.length <= TELEGRAM_MAX_LENGTH) {\n    results.push({\n      json: {\n        chat_id: chatId,\n        text: output,\n        message_part: 1,\n        total_parts: 1\n      }\n    });\n    continue;\n  }\n  \n  // Need to split - preserve line breaks and markdown\n  const chunks = [];\n  let currentChunk = '';\n  const lines = output.split('\\n');\n  \n  for (const line of lines) {\n    // Would adding this line exceed limit?\n    if ((currentChunk + line + '\\n').length > TELEGRAM_MAX_LENGTH) {\n      // Save current chunk if not empty\n      if (currentChunk) {\n        chunks.push(currentChunk.trim());\n        currentChunk = line + '\\n';\n      } else {\n        // Line itself is too long - split by words\n        const words = line.split(' ');\n        let tempLine = '';\n        \n        for (const word of words) {\n          if ((tempLine + word + ' ').length > TELEGRAM_MAX_LENGTH) {\n            if (tempLine) {\n              chunks.push(tempLine.trim());\n              tempLine = word + ' ';\n            } else {\n              // Single word too long - hard split\n              chunks.push(word.substring(0, TELEGRAM_MAX_LENGTH));\n              tempLine = word.substring(TELEGRAM_MAX_LENGTH) + ' ';\n            }\n          } else {\n            tempLine += word + ' ';\n          }\n        }\n        \n        if (tempLine) {\n          currentChunk = tempLine + '\\n';\n        }\n      }\n    } else {\n      currentChunk += line + '\\n';\n    }\n  }\n  \n  // Add remaining chunk\n  if (currentChunk) {\n    chunks.push(currentChunk.trim());\n  }\n  \n  const totalParts = chunks.length;\n  \n  // Create separate items for each chunk\n  chunks.forEach((chunk, index) => {\n    let messageText = chunk;\n    \n    // Add part indicator for multi-part messages\n    if (totalParts > 1) {\n      const partInfo = `\\n\\n\ud83d\udcc4 Part ${index + 1}/${totalParts}`;\n      // Only add if it fits\n      if ((chunk + partInfo).length <= TELEGRAM_MAX_LENGTH) {\n        messageText = chunk + partInfo;\n      }\n    }\n    \n    results.push({\n      json: {\n        chat_id: chatId,\n        text: messageText,\n        message_part: index + 1,\n        total_parts: totalParts\n      }\n    });\n  });\n}\n\nreturn results;"
