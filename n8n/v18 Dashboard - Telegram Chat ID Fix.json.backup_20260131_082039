rking\n   - Transportation - General\n   - Accommodation\n   - Entertainment\n   - Medical\n   - Miscellaneous\n\nVENDOR CATEGORY HINTS:\n- 7-Eleven, FamilyMart, Lawson \u2192 Meals - Snacks\n- Starbucks, Chagee, KOI \u2192 Meals - Drinks (unless meal items present)\n- Shell, Petron, Caltex \u2192 Transportation - Fuel/Gas\n- Grab, Uber \u2192 Transportation - Ride-Sharing\n- Singapore Airlines, AirAsia \u2192 Transportation - Flight\n\nJSON FORMAT (return this exactly):\n{\n  \"date\": \"DD-MMM-YYYY\",\n  \"time\": \"HH:MM\",\n  \"vendor\": \"Vendor Name\",\n  \"location\": \"City, Country\",\n  \"total_amount\": \"123.45\",\n  \"currency\": \"MYR\",\n  \"tax_amount\": \"12.34\",\n  \"category\": \"Meals - Lunch\",\n  \"overall_confidence\": 85,\n  \"comment\": \"Brief summary noting vendor type, OCR quality (${ocrConfidenceData.overall}%), currency decimal formatting, and fields requiring verification\"\n}\n\nCRITICAL: Return JSON only. No explanations.`;\n\nfunction shuffleArray(array) {\n  const shuffled = [...array];\n  for (let i = shuffled.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n  }\n  return shuffled;\n}\n\nconst shuffledProviders = shuffleArray(API_PROVIDERS);\nconst primaryProvider = shuffledProviders[0];\nconst fallbackProviders = shuffledProviders.slice(1);\n\n\nconst sleep = ms => new Promise(resolve => setTimeout(resolve, ms));\nconst MAX_RETRIES = 2;\nconst BASE_DELAY = 800;\n\nconst attemptedProviders = [];\nconst failedProviders = [];\n\nfunction formatCurrencyByCountry(amount, currency) {\n  if (!amount || amount === 'XXX') return amount;\n  \n  const cleanAmount = String(amount).replace(/[,\\s]/g, '');\n  const numAmount = parseFloat(cleanAmount);\n  \n  if (isNaN(numAmount)) return amount;\n  \n  const zeroDecimalCurrencies = ['IDR', 'KHR', 'VND', 'JPY', 'KRW', 'CLP', 'PYG'];\n  \n  if (zeroDecimalCurrencies.includes(currency)) {\n    const wholeNumber = Math.round(numAmount);\n    const formatted = wholeNumber.toLocaleString('en-US');\n    return formatted;\n  } else {\n    const formatted = numAmount.toLocaleString('en-US', {\n      minimumFractionDigits: 2,\n      maximumFractionDigits: 2\n    });\n    return formatted;\n  }\n}\n\nfunction analyzeConfidence(data, ocrConfidence) {\n  const confidenceThreshold = 75;\n  const lowConfidenceFields = [];\n  \n  const fieldConfidenceMap = {\n    date: data.date_confidence || 0,\n    time: data.time_confidence || 0,\n    vendor: data.vendor_confidence || 0,\n    location: data.location_confidence || 0,\n    total_amount: data.amount_confidence || 0,\n    currency: data.currency_confidence || 0,\n    tax_amount: data.tax_confidence || 0,\n    category: data.category_confidence || 0\n  };\n  \n  Object.keys(fieldConfidenceMap).forEach(field => {\n    const confidence = fieldConfidenceMap[field];\n    const fieldValue = data[field];\n    \n    if (confidence < confidenceThreshold && fieldValue === 'XXX') {\n      lowConfidenceFields.push({\n        field: field,\n        confidence: confidence,\n        value: fieldValue,\n        reason: confidence < 50 ? 'Very uncertain' : 'Needs verification'\n      });\n    }\n  });\n  \n  if (!data.overall_confidence) {\n    const confidenceValues = Object.values(fieldConfidenceMap);\n    const totalConfidence = confidenceValues.reduce((sum, conf) => sum + conf, 0);\n    data.overall_confidence = Math.round(totalConfidence / confidenceValues.length);\n  }\n  \n  const combinedConfidence = Math.round(\n    (data.overall_confidence * 0.7) + (ocrConfidence * 0.3)\n  );\n  \n  const hasXXXFields = Object.values(data).some(value => value === 'XXX');\n  const needsManualReview = hasXXXFields && (\n    combinedConfidence < confidenceThreshold || \n    lowConfidenceFields.length > 0\n  );\n  \n  return {\n    overall: data.overall_confidence,\n    combined: combinedConfidence,\n    ocr_quality: ocrConfidence,\n    threshold: confidence