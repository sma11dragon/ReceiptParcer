        "jsCode": "const currentItem = $input.first().json;\n\n// \u2705 ROBUST DATA RECOVERY: Use 'Execute Workflow Trigger' as the source of truth\n// Classify Text Input might replace the item. We recover original v17 data from trigger.\nconst originalItem = $(\"Execute Workflow Trigger\").first().json;\n\n\n// Get pending_record from current node (from Check Pending)\nconst pendingRecord = currentItem.pending_record;\n\n// Get base parameters from trigger\nconst routeTo = originalItem.route_to;\nconst messageText = originalItem.text || originalItem.message_text;\nconst chatId = originalItem.chat_id;\nconst classificationMetadata = currentItem.classification_metadata || {};\n\n// Validate we have required data\nif (!routeTo) {\n  throw new Error('Missing route_to field');\n}\n\nconst isShortText = messageText?.trim().length <= 3;\nconst isNumericOnly = /^\\d+$/.test(messageText?.trim() || '');\n\n// \u2705 Check for active fix workflow\nconst hasPendingFix = pendingRecord && \n                      pendingRecord.needs_review === true && \n                      (pendingRecord.conversation_state === 'awaiting_fix' ||\n                       pendingRecord.conversation_state === 'awaiting_field_input');\n\n\n// Decision logic\nlet finalRoute = routeTo;\n\n// Priority 1: If there's a pending fix workflow AND it's not a question\nif (hasPendingFix && !classificationMetadata.has_question_word && !classificationMetadata.has_question_mark) {\n    finalRoute = 'text_fix';\n}\n// Priority 2: Menu selection (numeric only, no pending fix)\nelse if (routeTo === 'ai_query' && isNumericOnly && !hasPendingFix) {\n    finalRoute = 'ai_query';\n}\n\n\n// \u2705 CRITICAL: Spread originalItem FIRST to ensure callback_data is preserved\nreturn [{\n    json: {\n        ...originalItem,\n        pending_record: pendingRecord,\n        route_to: finalRoute,\n        // Keep classification metadata if provided by Classify Text Input node\n        classification_metadata: classificationMetadata\n    },\n    binary: $input.first().binary || {}\n}];"
