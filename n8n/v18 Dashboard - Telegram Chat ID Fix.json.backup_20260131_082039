        "jsCode": "// Telegram Markdown Cleaner\n// Fixes malformed Markdown entities that cause Telegram API errors\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let text = item.json.text || '';\n  \n  \n  // Escape problematic Markdown characters for Telegram\n  // These characters need to be escaped: _ * [ ] ( ) ~ ` > # + - = | { } . !\n  \n  // Fix broken brackets (common issue)\n  text = text.replace(/\\[\\s*$/gm, ''); // Remove trailing [\n  text = text.replace(/^\\s*\\]/gm, ''); // Remove leading ]\n  \n  // Escape underscores that aren't part of bold/italic\n  // text = text.replace(/_/g, '\\\\_');\n  \n  // Remove or escape problematic Markdown\n  // Option 1: Just remove all Markdown formatting\n  text = text.replace(/\\*\\*/g, ''); // Remove bold **\n  text = text.replace(/\\*/g, '');   // Remove italic *\n  text = text.replace(/`/g, '');    // Remove code `\n  text = text.replace(/~/g, '');    // Remove strikethrough ~\n  \n  // Fix headers - Telegram doesn't support ### headers in Markdown mode\n  text = text.replace(/^###\\s+/gm, '\ud83d\udccc '); // Replace ### with emoji\n  text = text.replace(/^##\\s+/gm, '\ud83d\udccd ');  // Replace ## with emoji\n  text = text.replace(/^#\\s+/gm, '\ud83d\udd39 ');   // Replace # with emoji\n  \n  // Clean up extra whitespace\n  text = text.replace(/\\n{3,}/g, '\\n\\n');\n  text = text.trim();\n  \n  \n  results.push({\n    json: {\n      ...item.json,\n      text: text\n    }\n  });\n}\n\nreturn results;"
      },
