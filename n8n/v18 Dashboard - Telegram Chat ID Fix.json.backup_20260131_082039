      "parameters": {
        "jsCode": "const botToken = $input.first().json.bot_token;\n// Process Field Response - UNIVERSAL: Handles all input scenarios\nconst textInput = $input.first().json;\nconst userText = textInput.text || textInput.message_text;\nconst chatId = textInput.chat_id;\n\n\n// \u2705 SMART DATA DETECTION: Support multiple input scenarios\nlet pendingData = null;\n\n// Scenario 1: Data is nested in pending_record (from Smart Route Decision)\nif (textInput.pending_record) {\n  pendingData = textInput.pending_record;\n}\n// Scenario 2: Data is direct from database query (old flow)\nelse if (textInput.conversation_state || textInput['Conversation State']) {\n  pendingData = textInput;\n}\n// Scenario 3: Data comes from $input.all() (multiple items)\nelse {\n  const allItems = $input.all();\n  if (allItems.length > 0 && allItems[0].json) {\n    const firstItem = allItems[0].json;\n    // Check if first item has pending data\n    if (firstItem.conversation_state || firstItem['Conversation State']) {\n      pendingData = firstItem;\n    } else if (firstItem.pending_record) {\n      pendingData = firstItem.pending_record;\n    }\n  }\n}\n\nif (!pendingData) {\n  return [{\n    json: {\n      chat_id: chatId,\n      valid: false,\n      error_message: '\u274c No pending expense found. Please upload a receipt first.',\n      skip: true\n    ,\n    bot_token: botToken}\n  }];\n}\n\n\n// \u2705 FLEXIBLE FIELD ACCESS: Support both naming conventions\nfunction getField(obj, snakeCase, pascalCase) {\n  return obj[snakeCase] || obj[pascalCase] || null;\n}\n\nconst conversationState = getField(pendingData, 'conversation_state', 'Conversation State');\nconst reviewFieldsStr = getField(pendingData, 'review_fields', 'Review Fields') || '';\nconst currentIndex = parseInt(getField(pendingData, 'current_fix_index', 'Current Fix Index') || '0');\nconst recordId = pendingData.id || pendingData.ID;\n\n\nif (conversationState !== 'awaiting_field_input') {\n  return [{\n    json: {\n      chat_id: chatId,\n      valid: false,\n      error_message: '\u274c Not expecting input right now. Please click a button or upload a receipt.',\n      skip: true,\n      not_awaiting_input: true,\n    ,\n    bot_token: botToken}\n  }];\n}\n\n// Parse review fields (handle both {field1,field2} and plain text formats)\nconst cleanedStr = reviewFieldsStr.replace(/[{}]/g, '').trim();\nconst reviewFields = cleanedStr ? cleanedStr.split(',').map(f => f.trim()) : [];\n\n\nif (currentIndex >= reviewFields.length || reviewFields.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      valid: false,\n      error_message: '\u274c No fields to fix. Please select a payment method.',\n      skip: true\n    ,\n    bot_token: botToken}\n  }];\n}\n\nconst fieldToFix = reviewFields[currentIndex];\n\nlet validatedValue = userText.trim();\nlet isValid = true;\nlet errorMessage = '';\n\n// ========================================\n// VALIDATION FUNCTIONS\n// ========================================\n\nfunction isValidDate(value) {\n  const dateRegex1 = /^(\\d{2})-([A-Za-z]{3})-(\\d{4})$/;\n  const dateRegex2 = /^(\\d{2})-(\\d{2})-(\\d{2})$/;\n  \n  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const monthNumbers = {\n    'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,\n    'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11\n  };\n\n  let day, month, year;\n\n  const match1 = value.match(dateRegex1);\n  if (match1) {\n    day = parseInt(match1[1], 10);\n    month = monthNumbers[match1[2]];\n    year = parseInt(match1[3], 10);\n  } else {\n    const match2 = value.match(dateRegex2);\n    if (match2) {\n      day = parseInt(match2[1], 10);\n      month = parseInt(match2[2], 10) - 1;\n      year = parseInt(match2[3], 10) + 2000;\n    } else {\n      return { valid: false, error: 'Invalid date format. Use DD-MMM-YYYY (15-Nov-2025) or DD-MM-YY (06-07-25)' };\n    }\n  }\n\n  if (month === undefined