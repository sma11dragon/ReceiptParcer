      "parameters": {
        "jsCode": "const item = $input.first();\n\n// \u2705 V17 COMPATIBILITY: Respect upstream routing if present\nif (item.json.route_to && item.json.route_to !== 'unknown') {\n    return [{ json: item.json, binary: item.binary }];\n}\n\n// Handle both normalized (from v17) and original Telegram format\nconst hasCallback = !!(item.json.callback_query || item.json.callback_query_id);\nconst hasPhoto = !!(item.json.photo || item.json.message?.photo || item.json.is_image);\nconst hasDocument = !!(item.json.document || item.json.message?.document);\nconst hasText = !!(item.json.text || item.json.message?.text);\n\nconst mimeType = item.json.document?.mime_type || item.json.message?.document?.mime_type;\n\n// Enhanced file format detection\nconst isImage = item.json.is_image || hasPhoto || (hasDocument && (\n    mimeType?.startsWith('image/') || \n    mimeType === 'image/jpeg' ||\n    mimeType === 'image/jpg' ||\n    mimeType === 'image/png' ||\n    mimeType === 'image/heic' ||\n    mimeType === 'image/heif'\n));\n\nconst isPDF = item.json.is_pdf || (hasDocument && (\n    mimeType === 'application/pdf' ||\n    mimeType === 'application/x-pdf'\n));\n\n// Extract chat_id\nconst chatId = item.json.chat_id || \n               item.json.message?.chat?.id || \n               item.json.callback_query?.message?.chat?.id;\n\n// Handle callback\nif (hasCallback) {\n    return [{ \n        json: { \n            ...item.json, \n            route_to: 'callback',\n            chat_id: chatId\n        },\n        binary: item.binary\n    }];\n}\n\n// Handle images/PDFs\nif (isImage || isPDF) {\n    return [{ \n        json: { \n            ...item.json, \n            route_to: 'image', \n            is_pdf: isPDF,\n            chat_id: chatId\n        },\n        binary: item.binary\n    }];\n}\n\n// Handle text messages\nif (hasText) {\n    const messageText = item.json.text || item.json.message?.text || '';\n    const isReplyToBot = !!(item.json.message?.reply_to_message);\n    const replyText = item.json.message?.reply_to_message?.text || '';\n    const isBotAsking = replyText.includes('Would you like:') || \n                       replyText.includes('I can help!') ||\n                       replyText.includes('1)') ||\n                       replyText.includes('2)') ||\n                       replyText.includes('3)');\n    \n    // Question word detection\n    const questionWords = ['what', 'how', 'why', 'when', 'where', 'who', 'which', \n                           'can you', 'could you', 'tell me', 'show me', 'give me', \n                           'summarize', 'analyze', 'explain', 'list', 'find'];\n    \n    // Command pattern detection\n    const fixCommandPatterns = [\n        /^fix$/i, /^update$/i, /^correct$/i, /^change$/i, /^edit$/i\n    ];\n    \n    const isNumericOnly = /^\\d+$/.test(messageText.trim());\n    const isShortText = messageText.trim().length <= 3;\n    const questionMarks = (messageText.match(/\\?/g) || []).length;\n    const textLower = messageText.toLowerCase().trim();\n    const wordCount = messageText.trim().split(/\\s+/).length;\n    \n    const hasQuestionWord = questionWords.some(word => textLower.includes(word));\n    const hasQuestionMark = questionMarks > 0;\n    const isLongText = wordCount > 5;\n    const isFixCommand = fixCommandPatterns.some(pattern => pattern.test(messageText.trim()));\n    \n    let routeDestination = 'text_fix';\n    \n    if (isReplyToBot && isBotAsking) {\n        routeDestination = 'ai_query';\n    }\n    else if ((isNumericOnly || isShortText) && !isFixCommand) {\n        routeDestination = 'ai_query';\n    }\n    else if ((hasQuestionWord || hasQuestionMark) && !isFixCommand) {\n        routeDestination = 'ai_query';\n    }\n    else if (isLongText && !isFixCommand) {\n        routeDestination = 'ai_query';\n    }\n    else if (isFixCommand) {\n        routeDestination = 'text_fix';\n    }\n    \n    \n    return [{ \n        json: { \n            ...item.json, \n            route_to: routeDestination,\n            message_text: messageText,\n            chat_id: chatId,\n            classification_metadata: {\n                word_count: wordCount,\n                has_question_word: hasQuestionWord,\n                has_question_mark: hasQuestionMark,\n                is_fix_command: isFixCommand,\n                is_reply_to_bot: isReplyToBot,\n                is_numeric_only: isNumericOnly,\n                routing_decision: routeDestination\n            }\n        },\n        binary: item.binary\n    }];\n}\n\nreturn [{ \n    json: { \n        ...item.json, \n        route_to: 'unknown',\n        chat_id: chatId\n    },\n    binary: item.binary\n}];"
