n_success: true,\n                skip_image_optimization: true,\n                skip_google_vision: true // Skip Google Vision since we already have OCR text\n            },\n            binary: item.binary\n        }];\n    } else {\n        throw new Error('OCR.space API returned no results');\n    }\n    \n} catch (error) {\n    \n    return [{\n        json: {\n            ...item.json,\n            error: true,\n            error_message: `PDF processing failed: ${error.message}. Please try with an image file instead.`,\n            conversion_success: false\n        },\n        binary: item.binary\n    }];\n}"
