        needs_review: confidenceAnalysis.needs_manual_review,\n        review_fields: xxxFields,\n        confidence_scores: confidenceAnalysis,\n        submission_date: singaporeTimestamps.date,\n        submission_time: singaporeTimestamps.time,\n        submission_datetime: singaporeTimestamps.datetime,\n        submission_timezone: singaporeTimestamps.timezone,\n        submission_timestamp: singaporeTimestamps.iso_string,\n        attempted_providers: attemptedProviders\n      }\n    };\n    \n  } catch (error) {\n    const requestConfig = provider.config(prompt);\n    \n    const errorDetails = {\n      message: error.message,\n      statusCode: error.statusCode,\n      code: error.code,\n      stack: error.stack,\n      responseBody: error.response?.body || 'No response body',\n      responseHeaders: error.response?.headers || 'No response headers',\n      requestConfig: {\n        url: requestConfig.url,\n        method: requestConfig.method,\n        headers: requestConfig.headers ? Object.keys(requestConfig.headers) : 'No headers',\n        hasBody: !!requestConfig.body\n      }\n    };\n    \n    \n    failedProviders.push({\n      provider: provider.name,\n      attempt: attempt,\n      error: `Status ${error.statusCode}: ${error.message}`,\n      fullError: errorDetails\n    });\n    \n    if (attempt < MAX_RETRIES) {\n      const delay = error.statusCode === 429 ? BASE_DELAY * Math.pow(2, attempt) : BASE_DELAY;\n      await sleep(delay);\n      return processWithProvider.call(this, provider, prompt, attempt + 1);\n    }\n    \n    return { success: false };\n  }\n}\n\nlet result;\n\nresult = await processWithProvider.call(this, primaryProvider, PROMPT);\n\nif (!result.success) {\n  \n  for (const fallbackProvider of fallbackProviders) {\n    result = await processWithProvider.call(this, fallbackProvider, PROMPT);\n    \n    if (result.success) {\n      break;\n    }\n  }\n}\n\n// ==================== POST-PROCESSING: CATEGORY ENHANCEMENT =============