        "query": "WITH record_source AS (\n  -- Check expense_tracker_pending (UUID primary key)\n  SELECT \n    etp.id::text as id,\n    etp.chat_id::text as chat_id,\n    etp.date::text as date,\n    etp.time::text as time,\n    etp.vendor,\n    etp.amount::text as amount,\n    etp.currency,\n    etp.category,\n    etp.location,\n    etp.payment_method,\n    etp.comment,\n    etp.parsed_by,\n    etp.parsing_time::text as parsing_time,\n    etp.provider_tier,\n    etp.confidence_score::text as confidence_score,\n    etp.receipt_image_url,\n    etp.drive_file_id,\n    etp.needs_review::text as needs_review,\n    etp.review_fields,\n    etp.current_fix_index::text as current_fix_index,\n    etp.conversation_state,\n    NULL::text as amount_sgd,\n    NULL::text as exchange_rate,\n    etp.submission_datetime::text as submitted_at,\n    'pending' as source_table,\n    u.telegram_bot_token as bot_token,\n    u.id::text as user_id\n  FROM expense_tracker_pending etp\n  LEFT JOIN users u ON u.telegram_chat_id::text = etp.chat_id::text\n  WHERE etp.id::text = $1\n    AND etp.chat_id::text = $2\n  \n  UNION ALL\n  \n  -- Check expenses table (SERIAL primary key)\n  SELECT \n    e.id::text as id,\n    e.chat_id::text as chat_id,\n    e.expense_date::text as date,\n    e.expense_time::text as time,\n    e.vendor,\n    e.amount_original::text as amount,\n    e.currency,\n    e.category,\n    e.location,\n    e.payment_method,\n    e.comment,\n    e.parsed_by,\n    e.parsing_time::text as parsing_time,\n    e.provider_tier,\n    e.confidence_score::text as confidence_score,\n    e.receipt_image_url,\n    e.drive_file_id,\n    e.needs_review::text as needs_review,\n    e.review_fields,\n    e.current_fix_index::text as current_fix_index,\n    e.conversation_state,\n    e.amount_sgd::text as amount_sgd,\n    e.exchange_rate::text as exchange_rate,\n    e.submitted_at::text as submitted_at,\n    'expenses' as source_table,\n    u.telegram_bot_token as bot_token,\n    u.id::text as user_id\n  FROM expenses e\n  LEFT JOIN users u ON u.telegram_chat_id::text = e.chat_id::text\n  WHERE e.id::text = $1\n    AND e.chat_id::text = $2\n)\n-- Always return a row with all fields including source_table\nSELECT \n  COALESCE(id, 'NOT_FOUND') as id,\n  COALESCE(chat_id, $2) as chat_id,\n  date,\n  time,\n  vendor,\n  amount,\n  currency,\n  category,\n  location,\n  payment_method,\n  comment,\n  parsed_by,\n  parsing_time,\n  provider_tier,\n  confidence_score,\n  receipt_image_url,\n  drive_file_id,\n  needs_review,\n  review_fields,\n  current_fix_index,\n  conversation_state,\n  amount_sgd,\n  exchange_rate,\n  submitted_at,\n  COALESCE(source_table, 'not_found') as source_table,\n  bot_token,\n  user_id\nFROM record_source\nLIMIT 1;",
