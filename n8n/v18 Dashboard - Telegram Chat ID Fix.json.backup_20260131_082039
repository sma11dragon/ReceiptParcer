      "parameters": {
        "jsCode": "// DETERMINISTIC QUERY INTENT CLASSIFIER v7.2\n// IMPROVED: Full database field support, submitted_at detection, location/payment extraction\n// FIXED: Pass through bot_token for invalid query handling\nconst items = $input.all();\n    // Helper: Levenshtein distance for fuzzy matching\nconst results = [];\nfor (const item of items) {\n    const messageText = (item.json.message_text || item.json.text || '').toLowerCase().trim();\n    const originalMessage = item.json.message_text || item.json.text || '';\n    const chatId = item.json.chat_id;\n    const botToken = item.json.bot_token;\n    const classification = {\n        session_id: 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) { const r = Math.random()*16|0; return c === 'x' ? r.toString(16) : (r & 0x3 | 0x8).toString(16); }),\n        chat_id: chatId,\n        bot_token: botToken,\n        message_text: item.json.message_text || item.json.text,\n        query_type: 'unknown',\n        date_field: 'expense_date',\n        filters: {\n            date_from: null,\n            date_to: null,\n            category: null,\n            location: null,\n            vendor: null,\n            amount_filter: null,\n            payment_method: null\n        },\n        sort: null,\n        limit: null,\n        confidence: 0,\n        needs_clarification: false,\n        clarification_message: null,\n        is_valid_expense_query: true,\n        invalid_query_message: null\n    };\n    // Known locations for fuzzy matching\n    const knownLocations = [\n        \"singapore\", \"malaysia\", \"thailand\", \"cambodia\", \"indonesia\", \"vietnam\", \"philippines\",\n        \"japan\", \"korea\", \"china\", \"taiwan\", \"hong kong\", \"india\", \"australia\", \"usa\", \"united states\",\n        \"united kingdom\", \"uk\", \"germany\", \"france\", \"italy\", \"spain\", \"netherlands\", \"switzerland\",\n        \"kuala lumpur\", \"petaling jaya\", \"puchong\", \"johor\", \"penang\", \"bangkok\", \"phnom penh\",\n        \"jakarta\", \"manila\", \"tokyo\", \"seoul\", \"shanghai\", \"beijing\", \"hanoi\", \"ho chi minh\",\n        \"sydney\", \"melbourne\", \"london\", \"new york\", \"los angeles\", \"san francisco\"\n    ];\n\n    // Levenshtein distance helper\n    function levenshteinDistance(s1, s2) {\n        if (s1.length < s2.length) return levenshteinDistance(s2, s1);\n        if (s2.length === 0) return s1.length;\n        let previousRow = Array.from({length: s2.length + 1}, (_, i) => i);\n        for (let i = 0; i < s1.length; i++) {\n            let currentRow = [i + 1];\n            for (let j = 0; j < s2.length; j++) {\n                let insertions = previousRow[j + 1] + 1;\n                let deletions = currentRow[j] + 1;\n                let substitutions = previousRow[j] + (s1[i] !== s2[j]);\n                currentRow.push(Math.min(insertions, deletions, substitutions));\n            }\n            previousRow = currentRow;\n        }\n        return previousRow[previousRow.length - 1];\n    }\n    // 0. QUERY VALIDATION - Check if query is expense-related (NEW in v6.0)\n    const expenseKeywords = ['expense', 'expenses', 'receipt', 'receipts', 'transaction', 'transactions', 'spending', 'spent', 'cost', 'costs', 'paid', 'pay', 'payment', 'purchase', 'purchases', 'bought', 'buy', 'money', 'amount', 'total', 'sum', 'breakdown', 'summary', 'list', 'show', 'display', 'how many', 'how much', 'count', 'average', 'highest', 'lowest', 'cheapest', 'expensive', 'today', 'yesterday', 'this week', 'this month', 'last month', 'breakfast', 'lunch', 'dinner', 'meal', 'meals', 'food', 'transport', 'transportation', 'flight', 'groceries', 'shopping', 'category', 'vendor', 'sgd', 'myr', 'usd', 'thb'];\n    const hasExpenseKeyword = expenseKeywords.some(keyword => messageText.includes(keyword));\n    // Check for very short or nonsense queries\n    const isTooShort = messageText.length < 3;\n    const isJustPunctuation = /^[?!.,;:]+$/.test(messageText);\n    const isGreeting = /^(hi|hello|hey|yo|sup|greetings|good\\s*(morning|afternoon|evening))\\s*[!?.,]*$/i.test(messageText);\n    const isGibberish = /^(what|huh|eh|um|hmm|ok|okay|yes|no|yeah|nope|nah|lol|haha|wow|omg|wtf|idk|brb)\\s*[?!.,]*$/i.test(messageText);\n    const isQuestion = /^(do you|can you|are you|will you|would you|could you|should|what is|who is|where is|why|how do)\\s+(understand|know|help|work|do)/i.test(messageText);\n    const isCommand = /^(view|open|click|tap|see|look|watch|read|check)\\s*(receipt|image|photo|picture|file|link|url)?\\s*[?!.,]*$/i.test(messageText);\n    const isOffTopic = /^(weather|news|joke|story|song|music|game|play|cook|recipe|movie|sport|football|soccer)/i.test(messageText);\n    if (isTooShort || isJustPunctuation || isGreeting || isGibberish || isQuestion || isCommand || isOffTopic || !hasExpenseKeyword) {\n        classification.is_valid_expense_query = false;\n        classification.invalid_query_message = '\ud83e\udd16 I\\'m your **Expense Tracking Assistant**!\\n\\nI can only help with questions about your expenses and receipts. Here are some things you can ask me:\\n\\n\ud83d\udccb **View expenses:**\\n\u2022 \"Show me my expenses today\"\\n\u2022 \"List all meal expenses\"\\n\u2022 \"What did I spend this month?\"\\n\\n\ud83d\udd0d **Search & filter:**\\n\u2022 \"Show me Firstcoach receipts\"\\n\u2022 \"Find expenses over SGD 50\"\\n\u2022 \"List my dinner expenses\"\\n\\n\ud83d\udcca **Summaries:**\\n\u2022 \"What\\'s my total spending?\"\\n\u2022 \"Give me a breakdown by category\"\\n\u2022 \"What\\'s my most expensive receipt?\"\\n\\n\ud83d\udca1 Try one of these commands to get started!';\n        results.push({ json: classification });\n        continue;\n    }\n    // 1. AMOUNT FILTER EXTRACTION (More tolerant regex)\n    const amountMatch = messageText.match(/(?:over|above|more than|greater than|higher than)\\s*(?:sgd|myr|thb|\\$)?\\s*(\\d+(?:\\.\\d+)?)/i);\n    const amountBelowMatch = messageText.match(/(?:under|below|less than|lower than)\\s*(?:sgd|myr|thb|\\$)?\\s*(\\d+(?:\\.\\d+)?)/i);\n    if (amountMatch) {\n        classification.filters.amount_filter = { operator: '>', value: parseFloat(amountMatch[1]) };\n    } else if (amountBelowMatch) {\n        classification.filters.amount_filter = { operator: '<', value: parseFloat(amountBelowMatch[1]) };\n    }\n    // 2. LIMIT EXTRACTION\n    const limitPatterns = [\n        /\\b(?:top|first|last|lowest|highest|cheapest|bottom)\\s+(\\d+)\\b/i,\n        /\\b(\\d+)\\s+(?:top|first|last|lowest|highest|cheapest|bottom)\\b/i\n    ];\n    for (const pattern of limitPatterns) {\n        const match = messageText.match(pattern);\n        if (match) {\n            const digits = match[1] || match[2];\n            if (digits) classification.limit = parseInt(digits);\n            break;\n        }\n    }\n    // 3. QUERY TYPE DETECTION\n    if (/\\b(range|earliest|latest|first|last|oldest|newest).{0,50}\\b(date|time|when)s?\\b/i.test(messageText)) {\n        classification.query_type = 'summary';\n        classification.confidence = 95;\n    }\n    else if (/\\b(how many|count|number of|total (count|number)|how much)\\b/i.test(messageText)) {\n        classification.query_type = 'count';\n        classification.confidence = 95;\n    }\n    else if (/\\b(list|show (all|me)|display|give me).*\\b(expense|receipt|transaction)s?\\b/i.test(messageText)) {\n        classification.query_type = 'list';\n        classification.confidence = 90;\n    }\n    else if (/\\b(details?|info|information|tell me about|what (are|were))\\b/i.test(messageText)) {\n        classification.query_type = 'details';\n        classification.confidence = 85;\n    }\n    else if (/\\b(summar(y|ize)|total|breakdown|group by|average|spending habit)\\b/i.test(messageText) ||\n        /\\b(most expensive|cheapest|lowest|highest)\\b/i.test(messageText)) {\n        classification.query_type = 'summary';\n        classification.confidence = 90;\n    }\n    if (classification.query_type === 'unknown') {\n        classification.query_type = 'list';\n        classification.confidence = 50;\n    }\n    // 4. SORT ORDER\n    if (/\\b(most expensive|highest|largest|biggest)\\b/i.test(messageText)) {\n        classification.sort = 'amount_desc';\n        if (!classification.limit) classification.limit = 1;\n    }\n    else if (/\\b(cheapest|lowest|smallest)\\b/i.test(messageText)) {\n        classification.sort = 'amount_asc';\n        if (!classification.limit) classification.limit = 1;\n    }\n    // 5. DATE FIELD DETECTION (expense_date vs submitted_at)\n    // If user mentions \"submitted\", use submitted_at field instead of expense_date\n    if (/\\b(submitted|upload|sent|added)\\b/i.test(messageText)) {\n        classification.date_field = 'submitted_at';\n    }\n    // 5b. DATE FILTERS\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n    if (/\\btoday\\b/i.test(messageText)) {\n        const s = today.toISOString().split('T')[0];\n        classification.filters.date_from = s; classification.filters.date_to = s;\n    }\n    else if (/\\byesterday\\b/i.test(messageText)) {\n        const y = new Date(today); y.setDate(y.getDate() - 1);\n        const s = y.toISOString().split('T')[0];\n        classification.filters.date_from = s; classification.filters.date_to = s;\n    }\n    else if (/\\b(this\\s+week|current\\s+week)\\b/i.test(messageText)) {\n        const dayOfWeek = today.getDay();\n        const startOfWeek = new Date(today);\n        startOfWeek.setDate(today.getDate() - dayOfWeek);\n        classification.filters.date_from = startOfWeek.toISOString().split('T')[0];\n        classification.filters.date_to = today.toISOString().split('T')[0];\n    }\n    else if (/\\b(last\\s+week|previous\\s+week)\\b/i.test(messageText)) {\n        const dayOfWeek = today.getDay();\n        const startOfLastWeek = new Date(today);\n        startOfLastWeek.setDate(today.getDate() - dayOfWeek - 7);\n        const endOfLastWeek = new Date(startOfLastWeek);\n        endOfLastWeek.setDate(startOfLastWeek.getDate() + 6);\n        classification.filters.date_from = startOfLastWeek.toISOString().split('T')[0];\n        classification.filters.date_to = endOfLastWeek.toISOString().split('T')[0];\n    }\n    else if (/\\b(this\\s+month|current\\s+month)\\b/i.test(messageText)) {\n        const startOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);\n        classification.filters.date_from = startOfMonth.toISOString().split('T')[0];\n        classification.filters.date_to = today.toISOString().split('T')[0];\n    }\n    else if (/\\b(last\\s+month|previous\\s+month)\\b/i.test(messageText)) {\n        const startOfLastMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);\n        const endOfLastMonth = new Date(today.getFullYear(), today.getMonth(), 0);\n        classification.filters.date_from = startOfLastMonth.toISOString().split('T')[0];\n        classification.filters.date_to = endOfLastMonth.toISOString().split('T')[0];\n    }\n    const yearMatch = messageText.match(/\\b(in\\s*)?(20\\d{2})\\b/);\n    if (yearMatch) {\n        const year = parseInt(yearMatch[2]);\n        classification.filters.date_from = `${year}-01-01`;\n        classification.filters.date_to = `${year}-12-31`;\n    }\n    // Specific date pattern: \"on 15 Jan\" or \"on January 15\" or \"on 2026-01-15\"\n    const specificDateMatch = messageText.match(/\\bon\\s+(\\d{1,2})\\s*(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\\w*\\s*(\\d{4})?/i) || messageText.match(/\\bon\\s+(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\\w*\\s+(\\d{1,2})(?:st|nd|rd|th)?\\s*,?\\s*(\\d{4})?/i) || messageText.match(/\\bon\\s+(\\d{4}-\\d{2}-\\d{2})/i);\n    if (specificDateMatch) {\n        const months = {jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};\n        let dateStr;\n        if (specificDateMatch[0].includes('-')) {\n            dateStr = specificDateMatch[1];\n        } else {\n            const day = parseInt(specificDateMatch[1]) || parseInt(specificDateMatch[2]);\n            const monthStr = (specificDateMatch[2] || specificDateMatch[1]).toLowerCase().substring(0,3);\n            const year = specificDateMatch[3] ? parseInt(specificDateMatch[3]) : today.getFullYear();\n            const month = months[monthStr];\n            if (month !== undefined) {\n                dateStr = new Date(year, month, day).toISOString().split('T')[0];\n            }\n        }\n        if (dateStr) {\n            classification.filters.date_from = dateStr;\n            classification.filters.date_to = dateStr;\n        }\n    }\n    // 6. CATEGORY FILTER\n    const catKeywords = ['breakfast', 'lunch', 'dinner', 'snack', 'coffee', 'transport', 'shopping', 'groceries', 'flight', 'meal'];\n    const catMatch = messageText.match(new RegExp(`\\\\b(${catKeywords.join('|')})\\\\b`, 'i'));\n    if (catMatch) classification.filters.category = catMatch[1];\n    // 8. LOCATION FILTER EXTRACTION (ENHANCED v8.0)\n    // Multi-word location support with fuzzy matching\n    const locationPatterns = [\n        /\\b(?:in|at|from)\\s+(singapore|malaysia|thailand|cambodia|indonesia|vietnam|philippines|japan|korea|china|taiwan|hong kong|india)/i,\n        /\\b(?:in|at|from)\\s+(kuala lumpur|petaling jaya|puchong|johor|penang|singapore|bangkok|phnom penh|jakarta|manila|tokyo|seoul)/i\n    ];\n    let locationFound = false;\n    for (const pattern of locationPatterns) {\n        const match = messageText.match(pattern);\n        if (match && match[1]) {\n            classification.filters.location = match[1].trim();\n            locationFound = true;\n            break;\n        }\n    }\n    // If not found, try fuzzy matching for words after \"in|at|from\"\n    if (!locationFound) {\n        const locationPhraseMatch = messageText.match(/\\b(?:in|at|from)\\s+((?:the\\s+)?[a-z\\s]+?)(?=\\s+(?:expenses?|receipts?|transactions?|\\d|$))/i);\n        if (locationPhraseMatch) {\n            let possibleLocation = locationPhraseMatch[1].trim().toLowerCase();\n            // Remove leading \"the\"\n            possibleLocation = possibleLocation.replace(/^the\\s+/i, '');\n            // Split into words\n            const words = possibleLocation.split(/\\s+/);\n            // Check each word and combination against known locations\n            for (let i = 0; i < words.length; i++) {\n                for (let j = i; j < words.length; j++) {\n                    const phrase = words.slice(i, j + 1).join(' ');\n                    if (skipWords.includes(phrase)) continue;\n                    for (const knownLoc of knownLocations) {\n                        if (levenshteinDistance(phrase, knownLoc) <= 2) {\n                            classification.filters.location = knownLoc;\n                            locationFound = true;\n                            break;\n                        }\n                    }\n                    if (locationFound) break;\n                }\n                if (locationFound) break;\n            }\n        }\n    }\n    // If location found, ensure vendor is not set to same value\n    if (locationFound && classification.filters.vendor === classification.filters.location) {\n        classification.filters.vendor = null;\n    }\n    // 7. VENDOR FILTER EXTRACTION (v7.2 - Enhanced location avoidance)\n    // Extract vendor names from queries like \"show me Firstcoach receipts\"\n    // Skip words include common words, verbs, prepositions AND category keywords\n    const skipWords = ['my', 'me', 'the', 'all', 'recent', 'latest', 'oldest', 'newest', 'today', 'yesterday', 'this', 'last', 'show', 'list', 'display', 'give', 'get', 'find', 'receipts', 'receipt', 'expenses', 'expense', 'transactions', 'transaction', 'for', 'from', 'at', 'in', 'on', 'about', 'more', 'tell', 'what', 'how', 'many', 'much', 'and', 'or', 'with', 'down', 'up', 'out', 'off', 'over', 'under', 'through', 'into', 'onto', 'upon', 'a