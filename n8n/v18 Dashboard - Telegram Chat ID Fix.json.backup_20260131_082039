        "jsCode": "// Restore Formatted Currency - CONSISTENT FORMATTING (NO SYMBOLS)\nconst item = $input.first().json;\n\n\nfunction formatCurrencyComplete(amount, currencyCode) {\n  // Preserve original amount as string\n  const amountStr = String(amount);\n  \n  const zeroDecimalCurrencies = [\n    'BIF', 'CLP', 'DJF', 'GNF', 'ISK', 'JPY', 'KMF', 'KRW', 'PYG', 'RWF', \n    'UGX', 'VND', 'VUV', 'XAF', 'XOF', 'XPF', 'KHR', 'LAK', 'IDR', 'MMK', 'TWD'\n  ];\n  \n  const isZeroDecimal = zeroDecimalCurrencies.includes(currencyCode);\n  \n  if (isZeroDecimal) {\n    const numAmount = parseFloat(amountStr.replace(/,/g, ''));\n    if (isNaN(numAmount)) {\n      return { sheet: '0', raw: amountStr, decimals: 0 };\n    }\n    \n    // Use exact number formatting without rounding\n    const sheetFormat = numAmount.toLocaleString('en-US');\n    return { sheet: sheetFormat, raw: amountStr, decimals: 0 };\n  } else {\n    const numAmount = parseFloat(amountStr.replace(/,/g, ''));\n    if (isNaN(numAmount)) {\n      return { sheet: '0', raw: amountStr, decimals: 2 };\n    }\n    \n    const decimalPlaces = (amountStr.split('.')[1] || '').length;\n    const decimals = Math.max(decimalPlaces, 2);\n    \n    const sheetFormat = numAmount.toLocaleString('en-US', {\n      minimumFractionDigits: decimals,\n      maximumFractionDigits: decimals\n    });\n    \n    return { sheet: sheetFormat, raw: amountStr, decimals: decimals };\n  }\n}\n\nconst currency = item.Currency || item.currency || 'MYR';\n\n// Get the raw amount values from the pending sheet\nconst rawAmount = item.Amount || item.amount || '0';\nconst rawTax = item.Tax || item.tax || '0';\n\n// Reformat using consistent function\nconst amountFormatted = formatCurrencyComplete(rawAmount, currency);\nconst taxFormatted = formatCurrencyComplete(rawTax, currency);\n\n\nconst result = {\n  ...item,\n  // Use consistent sheet format for both Sheets AND Telegram\n  'Amount': amountFormatted.sheet,\n  'Tax': taxFormatted.sheet,\n  // Store raw values for calculations\n  'amount_raw': amountFormatted.raw,\n  'tax_raw': taxFormatted.raw,\n  'currency_decimals': amountFormatted.decimals\n};\n\n\nreturn [{\n  json: result\n}];"
