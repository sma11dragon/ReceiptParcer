      "parameters": {
        "jsCode": "const botToken = $input.first().json.bot_token;\n// ==================== VENDOR DATABASE & HELPER FUNCTIONS ====================\nconst VENDOR_DATABASE = {\n  convenience: [\n    '7-ELEVEN', 'SEVEN ELEVEN', '7-11', 'FAMILY MART', 'FAMILYMART', 'LAWSON', \n    'ALFAMART', 'INDOMARET', 'CIRCLE K', 'MINI STOP', 'MINISTOP', 'CHEERS', \n    'WATSONS', 'GUARDIAN', 'MANNINGS', 'OK CONVENIENCE', 'VANGUARD'\n  ],\n  \n  supermarket: [\n    'NTUC', 'FAIRPRICE', 'GIANT', 'TESCO', 'LOTUS', 'BIG C', 'TOPS', \n    'DON DON DONKI', 'DONKI', 'COLD STORAGE', 'JASON\\'S', 'MARKETPLACE',\n    'AEON', 'JUSCO', 'CARREFOUR', 'WALMART', 'TARGET', 'WHOLE FOODS'\n  ],\n  \n  coffee_tea: [\n    'STARBUCKS', 'COSTA', 'TOMORO', 'COFFEE BEAN', 'ARABICA', 'MELLOWER',\n    'LUCKIN', 'CHAGEE', 'MIXUE', 'TIGER SUGAR', 'XING FU TANG', 'GONG CHA',\n    'KOI', 'TEALIVE', 'COMEBUY', 'TEH TARIK', 'LIHO', 'CHATIME', 'EACH A CUP',\n    'DUNKIN', 'TIM HORTONS', 'PEET\\'S', 'BLUE BOTTLE', 'PACIFIC COFFEE'\n  ],\n  \n  fast_food: [\n    'MCDONALD', 'KFC', 'BURGER KING', 'SUBWAY', 'A&W', 'JOLLIBEE', \n    'WENDY\\'S', 'TACO BELL', 'PIZZA HUT', 'DOMINO', 'POPEYES', 'CHICK-FIL-A',\n    'FIVE GUYS', 'SHAKE SHACK', 'IN-N-OUT', 'YOSHINOYA', 'SUKIYA'\n  ],\n  \n  fuel: [\n    'SHELL', 'PETRON', 'ESSO', 'EXXON', 'MOBIL', 'CALTEX', 'CHEVRON', 'BP',\n    'TOTAL', 'SINOPEC', 'PETRONAS', 'SPC', 'CITGO', 'ARCO', '76', 'SUNOCO'\n  ],\n  \n  ride_sharing: [\n    'GRAB', 'UBER', 'LYFT', 'GO-JEK', 'GOJEK', 'DIDI', 'OLA', 'BOLT', 'TADA'\n  ],\n  \n  public_transit: [\n    'SMRT', 'SBS TRANSIT', 'MRT', 'LRT', 'EZ-LINK', 'KOMUTER', 'RAPID KL',\n    'BTS', 'MRT BANGKOK', 'TRANSJAKARTA', 'KRL', 'OCTOPUS', 'SUICA'\n  ],\n  \n  airlines: [\n    'SINGAPORE AIRLINES', 'MALAYSIAN AIRLINES', 'AIRASIA', 'JETSTAR',\n    'CATHAY PACIFIC', 'EMIRATES', 'QATAR', 'SCOOT', 'MALINDO', 'THAI AIRWAYS',\n    'GARUDA', 'CEBU PACIFIC', 'VIETNAM AIRLINES', 'VIETJET'\n  ],\n  \n  hotels: [\n    'MARRIOTT', 'HILTON', 'HYATT', 'SHANGRI-LA', 'INTERCONTINENTAL', \n    'HOLIDAY INN', 'IBIS', 'NOVOTEL', 'MERCURE', 'SOFITEL', 'FAIRMONT',\n    'AIRBNB', 'BOOKING.COM', 'AGODA', 'HOTELS.COM', 'EXPEDIA'\n  ]\n};\n\nfunction matchVendorDatabase(vendorName) {\n  if (!vendorName || vendorName === 'XXX') return null;\n  \n  const cleanVendor = vendorName.toUpperCase().replace(/[^A-Z0-9\\s]/g, '');\n  \n  for (const [category, vendors] of Object.entries(VENDOR_DATABASE)) {\n    for (const knownVendor of vendors) {\n      if (cleanVendor.includes(knownVendor) || knownVendor.includes(cleanVendor)) {\n        return { category, vendor: knownVendor, confidence: 95 };\n      }\n    }\n  }\n  \n  return null;\n}\n\nfunction detectTransportSubcategory(ocrText, vendorMatch, amount) {\n  const text = ocrText.toUpperCase();\n  \n  const fuelKeywords = ['PETROL', 'DIESEL', 'UNLEADED', 'PREMIUM', 'FUEL', 'GAS', 'LITERS', 'LITRES', 'GALLONS'];\n  const hasFuelKeyword = fuelKeywords.some(kw => text.includes(kw));\n  \n  if (vendorMatch?.category === 'fuel' || hasFuelKeyword) {\n    return { subcategory: 'Fuel/Gas', confidence: 95 };\n  }\n  \n  const flightKeywords = ['FLIGHT', 'BOARDING', 'GATE', 'SEAT', 'BAGGAGE', 'CHECK-IN', 'TERMINAL'];\n  const hasFlightKeyword = flightKeywords.some(kw => text.includes(kw));\n  \n  if (vendorMatch?.category === 'airlines' || hasFlightKeyword) {\n    return { subcategory: 'Flight', confidence: 95 };\n  }\n  \n  if (vendorMatch?.category === 'ride_sharing') {\n    return { subcategory: 'Ride-Sharing', confidence: 99 };\n  }\n  \n  const transitKeywords = ['TICKET', 'FARE', 'STATION', 'METRO', 'SUBWAY', 'BUS', 'TRAIN', 'RAIL'];\n  const hasTransitKeyword = transitKeywords.some(kw => text.includes(kw));\n  \n  if (vendorMatch?.category === 'public_transit' || hasTransitKeyword) {\n    const numAmount = parseFloat(String(amount).replace(/[,]/g, ''));\n    \n    if (numAmount < 10) return { subcategory: 'Bus/Metro', confidence: 90 };\n    if (numAmount < 50) return { subcategory: 'Train/Rail', confidence: 85 };\n    return { subcategory: 'Public Transit', confidence: 80 };\n  }\n  \n  const parkingKeywords = ['PARKING', 'PARK', 'CARPARK', 'VALET'];\n  if (parkingKeywords.some(kw => text.includes(kw))) {\n    return { subcategory: 'Parking', confidence: 95 };\n  }\n  \n  const tollKeywords = ['TOLL', 'ERP', 'EXPRESSWAY', 'HIGHWAY'];\n  if (tollKeywords.some(kw => text.includes(kw))) {\n    return { subcategory: 'Toll/ERP', confidence: 95 };\n  }\n  \n  const taxiKeywords = ['TAXI', 'CAB', 'COMFORT', 'CITYCAB'];\n  if (taxiKeywords.some(kw => text.includes(kw))) {\n    return { subcategory: 'Taxi', confidence: 90 };\n  }\n  \n  return { subcategory: 'General', confidence: 70 };\n}\n\nfunction inferMealCategory(vendorMatch, time, ocrText) {\n  if (vendorMatch?.category === 'convenience') {\n    return { category: 'Meals - Snacks', confidence: 95, reason: 'Convenience store' };\n  }\n  \n  if (vendorMatch?.category === 'supermarket') {\n    return { category: 'Groceries', confidence: 95, reason: 'Supermarket purchase' };\n  }\n  \n  if (vendorMatch?.category === 'coffee_tea') {\n    const mealKeywords = ['SANDWICH', 'BURGER', 'WRAP', 'SALAD', 'PASTA', 'RICE', 'NOODLE', 'BOWL'];\n    const hasMeal = mealKeywords.some(kw => ocrText.toUpperCase().includes(kw));\n    \n    if (hasMeal && time && time !== 'XXX') {\n      return inferMealFromTime(time, 'Coffee chain with meal items');\n    }\n    \n    return { category: 'Meals - Drinks', confidence: 95, reason: 'Coffee/tea chain' };\n  }\n  \n  if (time && time !== 'XXX') {\n    return inferMealFromTime(time, 'Time-based inference');\n  }\n  \n  const breakfastKeywords = ['BREAKFAST', 'MORNING', 'TOAST', 'EGG', 'BACON'];\n  const lunchKeywords = ['LUNCH', 'NOON'];\n  const dinnerKeywords = ['DINNER', 'EVENING', 'SUPPER'];\n  \n  const textUpper = ocrText.toUpperCase();\n  \n  if (breakfastKeywords.some(kw => textUpper.includes(kw))) {\n    return { category: 'Meals - Breakfast', confidence: 80, reason: 'Keyword detection' };\n  }\n  if (lunchKeywords.some(kw => textUpper.includes(kw))) {\n    return { category: 'Meals - Lunch', confidence: 80, reason: 'Keyword detection' };\n  }\n  if (dinnerKeywords.some(kw => textUpper.includes(kw))) {\n    return { category: 'Meals - Dinner', confidence: 80, reason: 'Keyword detection' };\n  }\n  \n  return { category: 'Meals - General', confidence: 60, reason: 'Default fallback' };\n}\n\nfunction inferMealFromTime(time, reason) {\n  const [hour] = time.split(':').map(Number);\n  \n  if (hour >= 0 && hour < 5) return { category: 'Meals - Supper', confidence: 90, reason };\n  if (hour >= 5 && hour < 11) return { category: 'Meals - Breakfast', confidence: 90, reason };\n  if (hour >= 11 && hour < 15) return { category: 'Meals - Lunch', confidence: 90, reason };\n  if (hour >= 15 && hour < 23) return { category: 'Meals - Dinner', confidence: 90, reason };\n  if (hour === 23) return { category: 'Meals - Supper', confidence: 90, reason };\n  \n  return { category: 'Meals - General', confidence: 70, reason: 'Invalid time' };\n}\n\n// ==================== MAIN OCR PROCESSING ====================\nconst ocrResponse = $input.first().json;\n\nif (!ocrResponse) {\n  return [{ \n    json: { \n      error: true, \n      message: 'No OCR response received', \n      chat_id: $('Process Image').first().json.chat_id, \n      status: 'error'\n    ,\n    bot_token: botToken} \n  }];\n}\n\nif (ocrResponse.error) {\n  const errorCode = ocrResponse.error.code;\n  const errorMessage = ocrResponse.error.message;\n  \n  \n  if (errorCode === 3 && errorMessage.includes('Bad image data')) {\n    return [{ \n      json: { \n        error: true, \n        message: 'Google Vision cannot process this PDF file. The PDF may be corrupted or encrypted.', \n        chat_id: $('Process Image').first().json.chat_id, \n        status: 'error',\n        error_details: {\n          code: errorCode,\n          message: errorMessage,\n          suggestion: 'Try using a different PDF file or convert it to image first'\n        ,\n    bot_token: botToken}\n      } \n    }];\n  }\n  \n  return [{ \n    json: { \n      error: true, \n      message: 'Google Vision Error: ' + errorMessage,\n      status: 'error',\n      error_code: errorCode\n    ,\n    bot_token: botToken} \n  }];\n}\n\nif (!ocrResponse.responses || !ocrResponse.responses[0]) {\n  return [{ \n    json: { \n      error: true, \n      message: 'Invalid OCR response structure - no responses array', \n      chat_id: $('Process Image').first().json.chat_id, \n      status: 'error',\n      response_structure: Object.keys(ocrResponse)\n    ,\n    bot_token: botToken} \n  }];\n}\n\nconst ocrData = ocrResponse.responses[0];\n\nif (!ocrData.textAnnotations || !ocrData.textAnnotations[0]) {\n  if (ocrData.fullTextAnnotation && ocrData.fullTextAnnotation.text) {\n    var ocrText = ocrData.fullTextAnnotation.text;\n  } else {\n    return [{ \n      json: { \n        error: true, \n        message: 'No OCR text found in response', \n        chat_id: $('Process Image').first().json.chat_id, \n        status: 'error',\n        available_data: Object.keys(ocrData)\n      ,\n    bot_token: botToken} \n    }];\n  }\n} else {\n  var ocrText = ocrData.textAnnotations[0].description;\n}\n\nconst chatId = $('Process Image').first().json.chat_id;\n\nif (!ocrText) {\n  return [{ \n    json: { \n      error: true, \n      message: 'No OCR text content found', \n      chat_id: chatId, \n      status: 'error' \n    ,\n    bot_token: botToken} \n  }];\n}\n\n\nfunction extractOCRConfidence(ocrData) {\n  const confidenceScores = {\n    overall: 0,\n    words: []\n  };\n  \n  try {\n    if (ocrData.fullTextAnnotation && ocrData.fullTextAnnotation.pages) {\n      const pages = ocrData.fullTextAnnotation.pages;\n      let totalWords = 0;\n      let totalConfidence = 0;\n      \n      pages.forEach(page => {\n        if (page.blocks) {\n          page.blocks.forEach(block => {\n            if (block.confidence) {\n              totalConfidence += block.confidence;\n              totalWords++;\n            }\n            \n            if (block.paragraphs) {\n              block.paragraphs.forEach(paragraph => {\n                if (paragraph.words) {\n                  paragraph.words.forEach(word => {\n                    if (word.confidence) {\n                      totalConfidence += word.confidence;\n                      totalWords++;\n                      \n                      const wordText = word.symbols\n                        ? word.symbols.map(s => s.text).join('')\n                        : '';\n                      \n                      confidenceScores.words.push({\n                        text: wordText,\n                        confidence: Math.round(word.confidence * 100)\n                      });\n                    }\n                  });\n                }\n              });\n            }\n          });\n        }\n      });\n      \n      if (totalWords > 0) {\n        confidenceScores.overall = Math.round((totalConfidence / totalWords) * 100);\n      }\n    }\n    \n    if (confidenceScores.overall === 0 && ocrData.textAnnotations && ocrData.textAnnotations.length > 1) {\n      let totalConfidence = 0;\n      let count = 0;\n      \n      for (let i = 1; i < Math.min(ocrData.textAnnotations.length, 100); i++) {\n        const annotation = ocrData.textAnnotations[i];\n        if (annotation.confidence !== undefined) {\n          totalConfidence += annotation.confidence;\n          count++;\n        }\n      }\n      \n      if (count > 0) {\n        confidenceScores.overall = Math.round((totalConfidence / count) * 100);\n      } else {\n        confidenceScores.overall = 85;\n      }\n    }\n    \n    if (confidenceScores.overall === 0) {\n      \n      if (ocrData.textAnnotations && ocrData.textAnnotations[0]) {\n        const textLength = ocrData.textAnnotations[0].description.length;\n        \n        if (textLength > 100) {\n          confidenceScores.overall = 85;\n        } else if (textLength > 50) {\n          confidenceScores.overall = 70;\n        } else {\n          confidenceScores.overall = 60;\n        }\n        \n      } else {\n        confidenceScores.overall = 50;\n      }\n    }\n    \n  } catch (error) {\n    confidenceScores.overall = 75;\n  }\n  \n  return confidenceScores;\n}\n\nconst ocrConfidenceData = extractOCRConfidence(ocrData);\n\nfunction getSingaporeTimestamps() {\n  const now = new Date();\n  const singaporeTime = new Date(now.getTime() + (8 * 60 * 60 * 1000));\n  \n  const day = String(singaporeTime.getDate()).padStart(2, '0');\n  const month = singaporeTime.toLocaleString('en-GB', { month: 'short', timeZone: 'Asia/Singapore' });\n  const year = singaporeTime.getFullYear();\n  const hour = String(singaporeTime.getHours()).padStart(2, '0');\n  const minute = String(singaporeTime.getMinutes()).padStart(2, '0');\n  \n  return {\n    date: `${day}-${month}-${year}`,\n    time: `${hour}:${minute}`,\n    datetime: `${day}-${month}-${year} ${hour}:${minute}`,\n    timezone: 'GMT+8',\n    timestamp: now.getTime(),\n    iso_string: now.toISOString()\n  };\n}\n\nconst singaporeTimestamps = getSingaporeTimestamps();\n\nfunction inferCambodiaFromDualCurrency(ocrText) {\n  const hasUSD = /\\$\\s*[\\d,]+\\.?\\d*|\\bUSD\\b/i.test(ocrText);\n  const hasKHR = /\\bKHR\\b|\\bRiel\\b/i.test(ocrText);\n  const hasLargeNumber = /[\\d,]{5,}/.test(ocrText);\n  \n  const hasKhmerScript = /[\\u1780-\\u17FF]/.test(ocrText);\n  const hasCambodiaPhone = /\\+855|\\(855\\)|855[\\s-]?\\d/.test(ocrText);\n  const hasPhnomPenh = /phnom\\s*penh|\u1797\u17d2\u1793\u17c6\u1796\u17c1\u1789/i.test(ocrText);\n  \n  const isDualCurrency = hasUSD && (hasKHR || hasLargeNumber);\n  const hasCambodiaIndicators = hasKhmerScript || hasCambodiaPhone || hasPhnomPenh;\n  \n  if (isDualCurrency || hasCambodiaIndicators) {\n    return true;\n  }\n  \n  return false;\n}\n\nconst isCambodiaReceipt = inferCambodiaFromDualCurrency(ocrText);\n\n// ==================== PRE-PROCESSING: VENDOR DETECTION ====================\n\nconst firstLines = ocrText.split('\\n').slice(0, 5).join(' ');\nconst vendorMatch = matchVendorDatabase(firstLines);\n\nif (vendorMatch) {\n} else {\n}\n\nconst API_PROVIDERS = [\n  {\n    name: 'Google Gemini 2.0 Flash',\n    tier: 'free',\n    enabled: true,\n    apiKey: 'AIzaSyA2cfjpSVhdVgBVJPNUyTDDzAxtEcASEpk',\n    config: (prompt) => ({\n      method: 'POST',\n      url: `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key=AIzaSyA2cfjpSVhdVgBVJPNUyTDDzAxtEcASEpk`,\n      headers: { 'Content-Type': 'application/json' },\n      body: {\n        contents: [{ parts: [{ text: prompt }] }],\n        generationConfig: { temperature: 0.1, maxOutputTokens: 1000 }\n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'Groq Llama 3.3 70B', \n    tier: 'free',\n    enabled: true,\n    apiKey: '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',\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.groq.com/openai/v1/chat/completions',\n      headers: { \n        'Authorization': 'Bearer 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',\n        'Content-Type': 'application/json' \n      },\n      body: { \n        model: 'llama-3.3-70b-versatile', \n        messages: [{ role: 'user', content: prompt }], \n        temperature: 0.1, \n        max_tokens: 1000 \n      },\n      json: true,\n      timeout: 10000\n    })\n  },\n  {\n    name: 'Together AI Qwen 2.5 72B',\n    tier: 'free',\n    enabled: true,\n    apiKey: '44ceef4e6dfb9e28b4a917428b8fa60cd2534337df09c21571a414f45646eade',\n    config: (prompt) => ({\n      method: 'POST',\n      url: 'https://api.together.xyz/v1/chat/completions',\n      headers: { \n        'Authorization': 'Bearer 44ceef4e6dfb9e28b4a917428b8fa60cd2534337df09c21571a414f45646eade', \n        'Content-Type': 'application/json' \n    