    {
      "parameters": {
        "jsCode": "// Prepare Complete Record for expenses - WITH TIMESTAMP SUPPORT\nconst item = $input.first().json;\n\nfunction convertToTimestamp(dateStr, timeStr) {\n  // Handle missing data\n  if (!dateStr || dateStr === 'XXX') {\n    throw new Error('Cannot move record with XXX date to expenses');\n  }\n  \n  const monthMap = {\n    'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04',\n    'May': '05', 'Jun': '06', 'Jul': '07', 'Aug': '08',\n    'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'\n  };\n  \n  let year, month, day;\n  \n  // Parse date: \"DD-Mon-YYYY\"\n  const match1 = dateStr.match(/^(\\d{2})-([A-Za-z]{3})-(\\d{4})$/);\n  if (match1) {\n    day = match1[1];\n    month = monthMap[match1[2]];\n    year = match1[3];\n  }\n  // Parse date: \"DD-MM-YYYY\"\n  else if (dateStr.match(/^(\\d{2})-(\\d{2})-(\\d{4})$/)) {\n    const match = dateStr.match(/^(\\d{2})-(\\d{2})-(\\d{4})$/);\n    day = match[1];\n    month = match[2];\n    year = match[3];\n  }\n  // Already \"YYYY-MM-DD\"\n  else if (dateStr.match(/^\\d{4}-\\d{2}-\\d{2}$/)) {\n    const parts = dateStr.split('-');\n    year = parts[0];\n    month = parts[1];\n    day = parts[2];\n  }\n  else {\n    throw new Error(`Unsupported date format: ${dateStr}`);\n  }\n  \n  // Parse time: \"HH:MM\" or default to 00:00\n  let hour = '00';\n  let minute = '00';\n  let second = '00';\n  \n  if (timeStr && timeStr !== 'XXX') {\n    const timeMatch = timeStr.match(/^(\\d{2}):(\\d{2})(?::(\\d{2}))?$/);\n    if (timeMatch) {\n      hour = timeMatch[1];\n      minute = timeMatch[2];\n      second = timeMatch[3] || '00';\n    }\n  }\n  \n  // Return ISO timestamp: \"YYYY-MM-DD HH:MM:SS\"\n  return `${year}-${month}-${day}T${hour}:${minute}:${second}.000Z`;\n}\n\nfunction convertSubmittedAt(dateTimeStr) {\n  if (!dateTimeStr) {\n    return new Date().toISOString();\n  }\n  \n  const monthMap = {\n    'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04',\n    'May': '05', 'Jun': '06', 'Jul': '07', 'Aug': '08',\n    'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'\n  };\n  \n  // Handle \"DD-Mon-YYYY HH:MM\"\n  const match = dateTimeStr.match(/^(\\d{2})-([A-Za-z]{3})-(\\d{4})\\s+(\\d{2}):(\\d{2})$/);\n  if (match) {\n    const day = match[1];\n    const month = monthMap[match[2]];\n    const year = match[3];\n    const hour = match[4];\n    const minute = match[5];\n    return `${year}-${month}-${day}T${hour}:${minute}:00.000Z`;\n  }\n  \n  return new Date().toISOString();\n}\n\n// Extract and convert ALL fields\nconst completeRecord = {\n  // Identity\n  chat_id: item.chat_id,\n  user_id: item.user_id, // \u2705 PROPAGATE USER_ID\n  bot_id: item.bot_id,   // \u2705 PROPAGATE BOT_ID\n  bot_id: item.bot_id,   // \u2705 PROPAGATE BOT_ID\n  \n  // Date & Time (COMBINED into timestamp)\n  expense_datetime: convertToTimestamp(item.date, item.time),\n  submitted_at: convertSubmittedAt(item.submission_datetime),\n  \n  // Core expense data\n  vendor: item.vendor,\n  amount_original: parseFloat(String(item.amount).replace(/,/g, '')),\n  currency: item.currency,\n  \n  // Classification\n  category: item.category,\n  location: item.location,\n  payment_method: item.payment_method,\n  \n  // Metadata\n  comment: item.comment,\n  parsed_by: item.parsed_by,\n  parsing_time: parseFloat(item.parsing_time || 0),\n  provider_tier: item.provider_tier,\n  confidence_score: parseInt(item.confidence_score || 0),\n  \n  // Image storage\n  receipt_image_url: item.receipt_image_url,\n  drive_file_id: item.drive_file_id,\n  \n  // Conversation state\n  needs_review: false,\n  review_fields: item.review_fields,\n  current_fix_index: item.current_fix_index,\n  conversation_state: 'completed'\n};\n\n\nreturn [{\n  json: completeRecord\n}];"
