        "jsCode": "// BUILD SUMMARY/AGGREGATION QUERY SQL v4.0\n// FIXED: Read from Classify Query Intent instead of input\nconst item = $('Classify Query Intent').first().json;\nconst chatId = item.chat_id;\nconst filters = item.filters;\nconst limit = item.limit || 1;\nconst messageText = item.message_text.toLowerCase();\nconst dateField = item.date_field || 'expense_date';\nlet sql = '';\nfunction addFilters(baseSql, includeCategory = true) {\n    let result = baseSql;\n    if (filters.date_from || filters.date_to) {\n        const dateColumn = dateField === 'submitted_at' ? `DATE(${dateField})` : dateField;\n        if (filters.date_from) result += ` AND ${dateColumn} >= '${filters.date_from}'`;\n        if (filters.date_to) result += ` AND ${dateColumn} <= '${filters.date_to}'`;\n    }\n    // Amount Filter\n    if (filters.amount_filter) {\n        const { operator, value } = filters.amount_filter;\n        result += ` AND amount_sgd ${operator} ${value}`;\n    }\n    if (includeCategory && filters.category) result += ` AND category ILIKE '%${filters.category}%'`;\n    if (filters.location) result += ` AND location ILIKE '%${filters.location}%'`;\n    if (filters.vendor) result += ` AND vendor ILIKE '%${filters.vendor}%'`;\n    if (filters.payment_method) result += ` AND payment_method ILIKE '%${filters.payment_method}%'`;\n    return result;\n}\n// ... logic branches ...\nif (/\\b(range|earliest|latest|first|last|oldest|newest).*?\\b(date|time|when)\\b/i.test(messageText)) {\n    sql = `SELECT MIN(expense_date) as earliest_date, MAX(expense_date) as latest_date, MIN(submitted_at) as earliest_submission, MAX(submitted_at) as latest_submission, COUNT(*) as total_count, SUM(amount_sgd) as total_sgd FROM expenses WHERE chat_id = '${chatId}'`;\n    sql = addFilters(sql);\n}\nelse if (/\\b(most expensive|highest|largest|biggest)\\b/i.test(messageText)) {\n    sql = `SELECT vendor, amount_original, amount_sgd, currency, category, location, expense_date, submitted_at FROM expenses WHERE chat_id = '${chatId}'`;\n    sql = addFilters(sql);\n    sql += ` ORDER BY amount_sgd DESC LIMIT ${limit}`;\n}\nelse if (/\\b(cheapest|lowest|smallest)\\b/i.test(messageText)) {\n    sql = `SELECT vendor, amount_original, amount_sgd, currency, category, location, expense_date, submitted_at FROM expenses WHERE chat_id = '${chatId}'`;\n    sql = addFilters(sql);\n    sql += ` ORDER BY amount_sgd ASC LIMIT ${limit}`;\n}\nelse if (/\\b(breakdown|group by|spending habit)\\b/i.test(messageText)) {\n    sql = `SELECT category, COUNT(*) as count, SUM(amount_sgd) as total_sgd, AVG(amount_sgd) as avg_sgd FROM expenses WHERE chat_id = '${chatId}'`;\n    sql = addFilters(sql);\n    sql += ` GROUP BY category ORDER BY total_sgd DESC`;\n}\nelse {\n    sql = `SELECT COUNT(*) as total_count, SUM(amount_sgd) as total_sgd, AVG(amount_sgd) as avg_sgd, MIN(amount_sgd) as min_sgd, MAX(amount_sgd) as max_sgd FROM expenses WHERE chat_id = '${chatId}'`;\n    sql = addFilters(sql);\n}\nreturn [{ json: { ...item, sql_query: sql, query_type: 'summary' } }];"
