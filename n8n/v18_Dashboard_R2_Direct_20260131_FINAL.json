    {
      "parameters": {
        "functionCode": "// Manual AWS SigV4 signing for Cloudflare R2\nconst crypto = require('crypto');\nconst now = new Date();\n\n// Format dates for AWS signature\nconst amzDate = now.toISOString().replace(/[\\-:]/g, '').split('.')[0] + 'Z';\nconst dateStamp = amzDate.split('T')[0];\n\n// Get image buffer from binary data\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const imageBuffer = item.binary.data.data;\n  const userId = item.json.user_id;\n  const filename = item.json.dynamic_filename;\n  \n  const fileKey = `receipts/${userId}/${filename}`;\n  const bucket = 'receiptai-images';\n  const endpoint = 'https://e21ca487c714259a0c1d0ff82c8e8ff6f.r2.cloudflarestorage.com';\n  const uploadUrl = `${endpoint}/${bucket}/${fileKey}`;\n  \n  // Calculate SHA256 of payload\n  const payloadHash = crypto.createHash('sha256').update(imageBuffer).digest('hex');\n  \n  // Create canonical request\n  const canonicalRequest = [\n    'PUT',\n    `/${bucket}/${fileKey}`,\n    '',\n    'host:e21ca487c714259a0c1d0ff82c8e8ff6f.r2.cloudflarestorage.com',\n    'x-amz-acl:public-read',\n    `x-amz-content-sha256:${payloadHash}`,\n    `x-amz-date:${amzDate}`,\n    '',\n    'host;x-amz-acl;x-amz-content-sha256;x-amz-date',\n    payloadHash\n  ].join('\\n');\n  \n  // Create string to sign\n  const algorithm = 'AWS4-HMAC-SHA256';\n  const credentialScope = `${dateStamp}/auto/s3/aws4_request`;\n  const stringToSign = [\n    algorithm,\n    amzDate,\n    credentialScope,\n    crypto.createHash('sha256').update(canonicalRequest).digest('hex')\n  ].join('\\n');\n  \n  // Calculate signature\n  const hmac = (key, msg) => crypto.createHmac('sha256', key).update(msg).digest();\n  const getSignatureKey = (key, dateStamp, regionName, serviceName) => {\n    const kDate = hmac(Buffer.from('AWS4' + key), dateStamp);\n    const kRegion = hmac(kDate, regionName);\n    const kService = hmac(kRegion, serviceName);\n    return hmac(kService, 'aws4_request');\n  };\n  \n  // Get credentials (should be set as environment variables in n8n)\n  // In n8n, set these as environment variables: R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY\n  const accessKeyId = $env.R2_ACCESS_KEY_ID || '01a434e4cb02672e8a7d3dd39735bc79';\n  const secretAccessKey = $env.R2_SECRET_ACCESS_KEY || 'HEX_API_KEY';\n  \n  if (!accessKeyId || !secretAccessKey) {\n    throw new Error('R2 credentials not found');\n  }\n  \n  const signingKey = getSignatureKey(secretAccessKey, dateStamp, 'auto', 's3');\n  const signature = hmac(signingKey, stringToSign).toString('hex');\n  \n  // Return signed request details\n  results.push({\n    json: {\n      ...item.json,\n      uploadUrl,\n      fileKey,\n      headers: {\n        'Content-Type': 'image/jpeg',\n        'x-amz-acl': 'public-read',\n        'x-amz-content-sha256': payloadHash,\n        'x-amz-date': amzDate,\n        'Authorization': `${algorithm} Credential=${accessKeyId}/${credentialScope}, SignedHeaders=host;x-amz-acl;x-amz-content-sha256;x-amz-date, Signature=${signature}`\n      },\n      imageBuffer: imageBuffer,\n      publicUrl: `https://receiptimages.daeit.com.sg/${fileKey}`\n    },\n    binary: item.binary\n  });\n}\n\nreturn results;"
      },
